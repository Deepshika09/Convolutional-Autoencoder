99"}},"outputId":"6284d4fe-c327-4f99-e798-845d5c64a1c6"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stderr","text":["100%|██████████| 9.91M/9.91M [00:00<00:00, 14.1MB/s]\n","100%|██████████| 28.9k/28.9k [00:00<00:00, 343kB/s]\n","100%|██████████| 1.65M/1.65M [00:00<00:00, 3.22MB/s]\n","100%|██████████| 4.54k/4.54k [00:00<00:00, 6.71MB/s]\n"]}]},{"cell_type":"code","source":["def add_noise(inputs, noise_factor=0.5):\n","    noisy = inputs + noise_factor * torch.randn_like(inputs)\n","    return torch.clamp(noisy, 0., 1.)\n"],"metadata":{"id":"fQKItSuJQUnO","executionInfo":{"status":"ok","timestamp":1773137932293,"user_tz":-330,"elapsed":16,"user":{"displayName":"Deepshika H","userId":"17431544114391291799"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["\n","class DenoisingAutoencoder(nn.Module):\n","    def __init__(self):\n","        super(DenoisingAutoencoder, self).__init__()\n","        self.encoder = nn.Sequential(\n","            nn.Conv2d(1, 16, kernel_size=3, padding=1),  # 28x28 -> 28x28\n","            nn.ReLU(),\n","            nn.MaxPool2d(2, 2),  # 28x28 -> 14x14\n","            nn.Conv2d(16, 8, kernel_size=3, padding=1),  # 14x14 -> 14x14\n","            nn.ReLU(),\n","            nn.MaxPool2d(2, 2)   # 14x14 -> 7x7\n","        )\n","        self.decoder = nn.Sequential(\n","            nn.ConvTranspose2d(8, 16, kernel_size=2, stride=2),  # 7x7 -> 14x14\n","            nn.ReLU(),\n","            nn.ConvTranspose2d(16, 1, kernel_size=2, stride=2),  # 14x14 -> 28x28\n","            nn.Sigmoid()  # Ensure output values between 0 and 1\n","        )\n","\n","    def forward(self, x):\n","        x = self.encoder(x)\n","        x = self.decoder(x)\n","        return x"],"metadata":{"id":"WSaMns89QUqK","executionInfo":{"status":"ok","timestamp":1773137948063,"user_tz":-330,"elapsed":6,"user":{"displayName":"Deepshika H","userId":"17431544114391291799"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["\n","model = DenoisingAutoencoder().to(device)\n","criterion = nn.MSELoss()\n","optimizer = optim.Adam(model.parameters(), lr=1e-3)"],"metadata":{"id":"Eddv3pZRQUsA","executionInfo":{"status":"ok","timestamp":1773137963780,"user_tz":-330,"elapsed":29,"user":{"displayName":"Deepshika H","userId":"17431544114391291799"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["summary(model, input_size=(1, 28, 28))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"afCZ7L26QUt7","executionInfo":{"status":"ok","timestamp":1773137977564,"user_tz":-330,"elapsed":373,"user":{"displayName":"Deepshika H","userId":"17431544114391291799"}},"outputId":"f8bfb947-eb0b-4a58-fe2e-f384788c6f3d"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["----------------------------------------------------------------\n","        Layer (type)               Output Shape         Param #\n","================================================================\n","            Conv2d-1           [-1, 16, 28, 28]             160\n","              ReLU-2           [-1, 16, 28, 28]               0\n","         MaxPool2d-3           [-1, 16, 14, 14]               0\n","            Conv2d-4            [-1, 8, 14, 14]           1,160\n","              ReLU-5            [-1, 8, 14, 14]               0\n","         MaxPool2d-6              [-1, 8, 7, 7]               0\n","   ConvTranspose2d-7           [-1, 16, 14, 14]             528\n","              ReLU-8           [-1, 16, 14, 14]               0\n","   ConvTranspose2d-9            [-1, 1, 28, 28]              65\n","          Sigmoid-10            [-1, 1, 28, 28]               0\n","================================================================\n","Total params: 1,913\n","Trainable params: 1,913\n","Non-trainable params: 0\n","----------------------------------------------------------------\n","Input size (MB): 0.00\n","Forward/backward pass size (MB): 0.30\n","Params size (MB): 0.01\n","Estimated Total Size (MB): 0.31\n","----------------------------------------------------------------\n"]}]},{"cell_type":"code","source":["def train(model, loader, criterion, optimizer, epochs=5):\n","    model.train()\n","    for epoch in range(epochs):\n","        total_loss = 0\n","        for images, _ in loader:\n","            images = images.to(device)\n","            noisy_images = add_noise(images).to(device)\n","\n","            outputs = model(noisy_images)\n","            loss = criterion(outputs, images)\n","\n","            optimizer.zero_grad()\n","            loss.backward()\n","            optimizer.step()\n","\n","            total_loss += loss.item()\n","\n","        print(f\"Epoch [{epoch+1}/{epochs}], Loss: {total_loss/len(loader):.4f}\")\n",""],"metadata":{"id":"N9UHuBeJQUw8","executionInfo":{"status":"ok","timestamp":1773137990396,"user_tz":-330,"elapsed":51,"user":{"displayName":"Deepshika H","userId":"17431544114391291799"}}},"execution_count":9,"outputs":[]},{"cell_type":"code","source":["def visualize_denoising(model, loader, num_images=5):\n","    model.eval()\n","    with torch.no_grad():\n","        for images, _ in loader:\n","            images = images.to(device)\n","            noisy_images = add_noise(images).to(device)\n","            outputs = model(noisy_images)\n","            break\n","\n","    images = images.cpu().numpy()\n","    noisy_images = noisy_images.cpu().numpy()\n","    outputs = outputs.cpu().numpy()\n","\n","    print(\"Name:    Deepshika Hemanth kumar\")\n","    print(\"Register Number: 212224220020\")\n","    plt.figure(figsize=(18, 6))\n","    for i in range(num_images):\n","        # Original\n","        ax = plt.subplot(3, num_images, i + 1)\n","        plt.imshow(images[i].squeeze(), cmap='gray')\n","        ax.set_title(\"Original\")\n","        plt.axis(\"off\")\n","\n","        # Noisy\n","        ax = plt.subplot(3, num_images, i + 1 + num_images)\n","        plt.imshow(noisy_images[i].squeeze(), cmap='gray')\n","        ax.set_title(\"Noisy\")\n","        plt.axis(\"off\")\n","\n","        # Denoised\n","        ax = plt.subplot(3, num_images, i + 1 + 2 * num_images)\n","        plt.imshow(outputs[i].squeeze(), cmap='gray')\n","        ax.set_title(\"Denoised\")\n","        plt.axis(\"off\")\n","\n","    plt.tight_layout()\n","    plt.show()\n",""],"metadata":{"id":"sHBjr99VQpaj","executionInfo":{"status":"ok","timestamp":1773138722811,"user_tz":-330,"elapsed":18,"user":{"displayName":"Deepshika H","userId":"17431544114391291799"}}},"execution_count":15,"outputs":[]},{"cell_type":"code","source":["train(model, train_loader, criterion, optimizer, epochs=5)\n","visualize_denoising(model, test_loader)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"CQ_RTPD5RJFk","outputId":"acc4a267-6aa8-480e-bad0-fbd997234079"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch [1/5], Loss: 0.0208\n","Epoch [2/5], Loss: 0.0204\n","Epoch [3/5], Loss: 0.0202\n","Epoch [4/5], Loss: 0.0200\n"]}]}]}